          },
          "nonce": {
            "type": "number",
            "description": "The signer's next nonce from accounts_get_nonce"
          },
          "recipient": { "type": "string" },
          "value": { "type": "string" },
          "token": { "type": "string" },
          "source_chain_id": { "type": "number" },
          "source_tx_hash": { "type": "string" },
          "bridge_metadata": { "type": "string" }
        },
        "required": ["chain_id", "nonce", "recipient", "value", "token", "source_chain_id", "source_tx_hash", "bridge_metadata"]
      },
      "memo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "format": { "type": "string" },
          "data": { "type": "string" }
        },
        "required": [],
        "description": "Optional transaction memo"
      }
    },
    "required": ["unsigned"],
    "description": "Prepare a v2 bridge-and-mint. Sends nothing. Returns signing_hash: sign it (utils_sign_digest or your own wallet), then call transactions_submit with the returned operation, unsigned and memo, and the signature."
  },
  "tokens.prepare_burn_and_bridge": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "unsigned": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chain_id": {
            "type": "number",
            "description": "Chain id from chain_get_chain_id"
          },
          "nonce": {
            "type": "number",
            "description": "The signer's next nonce from accounts_get_nonce"
          },
          "sender": { "type": "string" },
          "value": { "type": "string" },
          "token": { "type": "string" },
          "destination_chain_id": { "type": "number" },
          "destination_address": { "type": "string" },
          "escrow_fee": { "type": "string" },
          "bridge_metadata": { "type": "string" },
          "bridge_param": { "type": "string", "description": "0x-prefixed hex bytes" }
        },
        "required": ["chain_id", "nonce", "sender", "value", "token", "destination_chain_id", "destination_address", "escrow_fee", "bridge_metadata", "bridge_param"]
      },
      "memo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "format": { "type": "string" },
          "data": { "type": "string" }
        },
        "required": [],
        "description": "Optional transaction memo"
      }
    },
    "required": ["unsigned"],
    "description": "Prepare a v2 burn-and-bridge. Sends nothing. Returns signing_hash: sign it (utils_sign_digest or your own wallet), then call transactions_submit with the returned operation, unsigned and memo, and the signature."
  },
