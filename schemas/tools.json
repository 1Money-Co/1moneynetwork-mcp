  "tokens.prepare_issue": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "unsigned": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chain_id": {
            "type": "number",
            "description": "Chain id from chain_get_chain_id"
          },
          "nonce": {
            "type": "number",
            "description": "The signer's next nonce from accounts_get_nonce"
          },
          "symbol": { "type": "string" },
          "name": { "type": "string" },
          "decimals": { "type": "number" },
          "master_authority": { "type": "string" },
          "is_private": { "type": "boolean" },
          "clawback_enabled": { "type": "boolean", "description": "Default true" }
        },
        "required": ["chain_id", "nonce", "symbol", "name", "decimals", "master_authority", "is_private"]
      },
      "memo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "format": { "type": "string" },
          "data": { "type": "string" }
        },
        "required": [],
        "description": "Optional transaction memo"
      }
    },
    "required": ["unsigned"],
    "description": "Prepare a v2 token issue. Sends nothing. Returns signing_hash: sign it (utils_sign_digest or your own wallet), then call transactions_submit with the returned operation, unsigned and memo, and the signature."
  },
  "tokens.prepare_burn": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "unsigned": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chain_id": {
            "type": "number",
            "description": "Chain id from chain_get_chain_id"
          },
          "nonce": {
            "type": "number",
            "description": "The signer's next nonce from accounts_get_nonce"
          },
          "value": { "type": "string", "description": "Amount in the token's base unit" },
          "token": { "type": "string", "description": "Token address" }
        },
        "required": ["chain_id", "nonce", "value", "token"]
      },
      "memo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "format": { "type": "string" },
          "data": { "type": "string" }
        },
        "required": [],
        "description": "Optional transaction memo"
      }
    },
    "required": ["unsigned"],
    "description": "Prepare a v2 burn of the signer's own tokens. Sends nothing. Returns signing_hash: sign it (utils_sign_digest or your own wallet), then call transactions_submit with the returned operation, unsigned and memo, and the signature."
  },
  "tokens.prepare_bridge_and_mint": {
    "type": "object",
