    },
    "required": ["hash"]
  },
  "transactions.get_status_by_hash": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "hash": { "type": "string" }
    },
    "required": ["hash"],
    "description": "Read a transaction's status by hash: pending, certified_pending_checkpoint, checkpointed or finalized."
  },
  "transactions.get_receipt_by_hash": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "hash": { "type": "string" }
    },
    "required": ["hash"]
  },
  "transactions.get_finalized_by_hash": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
