    },
    "required": ["hash"]
  },
  "transactions.estimate_fee": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "from": { "type": "string", "description": "Sender address" },
      "to": { "type": "string", "description": "Recipient address" },
      "value": { "type": ["string", "number"] },
      "token": { "type": "string", "description": "Token address" }
    },
    "required": ["from", "to", "value", "token"],
    "description": "Estimate the fee of a payment."
  },
  "transactions.prepare_payment": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "unsigned": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chain_id": {
            "type": "number",
            "description": "Chain id from chain_get_chain_id"
          },
          "nonce": {
            "type": "number",
            "description": "The signer's next nonce from accounts_get_nonce"
          },
          "recipient": { "type": "string" },
          "value": { "type": "string", "description": "Amount in the token's base unit" },
          "token": { "type": "string", "description": "Token address" }
        },
        "required": ["chain_id", "nonce", "recipient", "value", "token"]
      },
      "memo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "format": { "type": "string" },
          "data": { "type": "string" }
        },
        "required": [],
        "description": "Optional transaction memo"
      }
    },
    "required": ["unsigned"],
    "description": "Prepare a v2 payment. Sends nothing. Returns signing_hash: sign it (utils_sign_digest or your own wallet), then call transactions_submit with the returned operation, unsigned and memo, and the signature."
  },
  "transactions.submit": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operation": {
        "type": "string",
        "enum": ["payment", "tokenIssue", "tokenBurn", "tokenBridgeAndMint", "tokenBurnAndBridge"],
        "description": "The operation a prepare tool returned"
      },
      "unsigned": {
        "type": "object",
        "additionalProperties": true,
        "description": "The unsigned payload a prepare tool returned, unchanged"
      },
      "memo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "format": { "type": "string" },
          "data": { "type": "string" }
        },
        "required": [],
        "description": "Optional transaction memo"
      },
      "signature": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "r": { "type": "string", "description": "0x-prefixed 32-byte hex" },
          "s": { "type": "string", "description": "0x-prefixed 32-byte hex, low-S" },
          "v": { "type": ["number", "boolean"] }
        },
        "required": ["r", "s", "v"],
        "description": "secp256k1 signature of signing_hash"
      }
    },
    "required": ["operation", "unsigned", "signature"],
    "description": "Authorize a prepared v2 transaction with its signature and send it once to POST /v2. On an error, the result says whether it was submitted (false, true or \"unknown\") and the next step. Never sign the same intent again after submitted true or \"unknown\": read the status by hash first."
  },
  "utils.derive_token_address": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "wallet_address": { "type": "string" },
      "mint_address": { "type": "string" }
    },
    "required": ["wallet_address", "mint_address"]
  },
  "utils.sign_digest": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "signing_hash": {
        "type": "string",
        "description": "0x-prefixed 32-byte digest from a prepare tool"
      },
      "private_key": { "type": "string" }
    },
    "required": ["signing_hash", "private_key"],
    "description": "Sign a 32-byte digest with a secp256k1 private key. The key passes through this conversation: use it only with test keys."
  },
  "utils.encode_payload": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "payload": { "type": ["string", "number", "boolean", "object", "array", "null"] }
    },
    "required": ["payload"]
  },
  "utils.to_hex": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "value": {}
    },
    "required": ["value"]
  },
  "utils.typeof": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "value": {}
    },
    "required": ["value"]
  },
  "utils.safe_promise_all": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "calls": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": { "type": "string" },
            "input": { "type": "object", "additionalProperties": true }
          },
          "required": ["tool", "input"]
        }
      }
    },
    "required": ["calls"],
    "description": "Run tool calls in parallel; fails on the first error. A batch cannot contain transactions.submit: send each transaction on its own, so its outcome is never lost."
  },
  "utils.safe_promise_line": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "calls": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": { "type": "string" },
            "input": { "type": "object", "additionalProperties": true }
          },
          "required": ["tool", "input"]
        }
      }
    },
    "required": ["calls"],
    "description": "Run tool calls in order; drops the results of calls that fail. A batch cannot contain transactions.submit: send each transaction on its own, so its outcome is never lost."
  }
}
